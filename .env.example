# ===================================================================
# SecretSpace - Environment Configuration
# ===================================================================

# -------------------------------------------------------------------
# PUBLIC CLIENT ENVIRONMENT VARIABLES (Vite / Vercel frontend)
# Safe to expose in the browser client bundle.
# -------------------------------------------------------------------

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
# Example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=""

# Supabase Anon Public Key (From Supabase Dashboard -> Project Settings -> API)
# This is safe for the browser client bundle. Row Level Security (RLS) protects data.
VITE_SUPABASE_ANON_KEY=""

# (Optional) WebRTC TURN server configuration for restrictive networks/firewalls.
# Default public Google STUN server (stun:stun.l.google.com:19302) is built-in.
# If peers cannot connect behind symmetric NATs or corporate firewalls, supply a TURN relay (e.g., Metered.ca, Twilio, or Xirsys):
VITE_TURN_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""

# -------------------------------------------------------------------
# PRIVATE BACKEND VARIABLES (Server-side / Supabase Edge Functions / Vercel Serverless ONLY)
# NEVER expose in frontend code or client bundles.
# -------------------------------------------------------------------

# Supabase Service Role Key (Used ONLY by administrative cron cleanup jobs / Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=""

# Secret passphrase for initial room master key derivation (optional server salt)
SECRETSPACE_MASTER_SALT=""
